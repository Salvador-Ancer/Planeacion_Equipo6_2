# ============================================================
# Variables de entorno requeridas para ejecutar la aplicación
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.
# ============================================================

# Oracle Database
DB_URL=jdbc:oracle:thin:@<alias_tns>?TNS_ADMIN=/ruta/al/wallet
DB_USER=ADMIN
DB_PASSWORD=<password_de_la_bd>
TNS_ADMIN_PATH=/ruta/al/wallet

# Telegram Bot
TELEGRAM_BOT_TOKEN=<token_del_bot>
TELEGRAM_BOT_NAME=koookkii_bot

# APIs de IA
DEEPSEEK_API_KEY=<tu_api_key_deepseek>
ANTHROPIC_API_KEY=<tu_api_key_anthropic>
GROQ_API_KEY=<tu_api_key_groq>

# ORDS / RAG
ORDS_BASE_URL=https://<tu_instancia>.adb.<region>.oraclecloudapps.com/ords/admin
ATP_PASSWORD=<password_del_atp>

# Spring profile (prod activa JSON logging + nivel WARN)
SPRING_PROFILES_ACTIVE=prod
