FROM openjdk:22-jdk
RUN mkdir -p /mtdrworkshop/creds
COPY wallet/ /mtdrworkshop/creds
WORKDIR /tmp/
EXPOSE 8080
COPY target/MyTodoList-0.0.1-SNAPSHOT.jar MyTodoList.jar

# Las credenciales NO van en el Dockerfile.
# Pásalas en tiempo de ejecución con --env-file .env o con Kubernetes Secrets.
# Ejemplo: docker run --env-file .env <imagen>

ENTRYPOINT ["java", "-Dspring.profiles.active=prod", "-jar", "MyTodoList.jar"]