          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- W02: GET /tareas (extract sprintId and proyectoId for POST payload) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="W02 GET /tareas (extract IDs)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
